<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản Lý Bác Sĩ</title>
    
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css">
    
    <link rel="stylesheet" href="/css/admin/sidebar.css">
    <link rel="stylesheet" href="/css/admin/style.css">
    <link rel="stylesheet" href="/css/admin/quanLyBacSi/quanLyBacSi.css">

<style nonce="<%= cspNonce %>">
/* Các lớp thay thế thuộc tính style nội tuyến để tương thích CSP. */
.csp-admin-quanlybacsi-quanlybacsi-ejs-11 { background-color: #f4f6f9; }
.csp-admin-quanlybacsi-quanlybacsi-ejs-10 { color: var(--primary-color, #2c3e50); }
.csp-admin-quanlybacsi-quanlybacsi-ejs-9 { width: 5%; }
.csp-admin-quanlybacsi-quanlybacsi-ejs-8 { width: 20%; }
.csp-admin-quanlybacsi-quanlybacsi-ejs-7 { width: 15%; }
.csp-admin-quanlybacsi-quanlybacsi-ejs-6 { width: 20%; }
.csp-admin-quanlybacsi-quanlybacsi-ejs-5 { width: 25%; }
.csp-admin-quanlybacsi-quanlybacsi-ejs-4 { width: 15%; }
.csp-admin-quanlybacsi-quanlybacsi-ejs-3 { color: var(--primary-color); }
.csp-admin-quanlybacsi-quanlybacsi-ejs-2 { max-width: 200px; }
.csp-admin-quanlybacsi-quanlybacsi-ejs-1 { font-size: 48px; opacity: 0.2; }
</style>
    <!-- SweetAlert2: tải CSS tĩnh để không bị CSP chặn style do JS chèn vào -->
    <link rel="stylesheet" href="/vendor/sweetalert2/sweetalert2.min.css?v=11.26.25">

<script src="/vendor/sweetalert2/sweetalert2.min.js?v=11.26.25"></script>
<script src="/js/sweetalert-global.js?v=4"></script>
    
</head>
<body>
    
    <div class="d-flex vh-100 overflow-hidden csp-admin-quanlybacsi-quanlybacsi-ejs-11"> 
        
        <%- include('../sidebar') %>

        <div class="main-content flex-grow-1 p-3 p-md-4 overflow-auto">
            
            <div class="card-box bg-white p-4 rounded shadow-sm border-0">
                
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4 pb-2 border-bottom">
                    <h2 class="mb-0 fw-bold csp-admin-quanlybacsi-quanlybacsi-ejs-10">Quản Lý Danh Sách Bác Sĩ</h2>
                    
                    <a href="/admin/themBacSi" class="btn-add text-nowrap text-decoration-none">
                        <i class="fas fa-plus"></i> Thêm Bác Sĩ Mới
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="custom-table w-100">
                        <thead>
                            <tr>
                                <th class="text-center csp-admin-quanlybacsi-quanlybacsi-ejs-9">STT</th>
                                <th class="csp-admin-quanlybacsi-quanlybacsi-ejs-8">Họ Tên</th>
                                <th class="text-center csp-admin-quanlybacsi-quanlybacsi-ejs-7">Năm Tốt Nghiệp</th>
                                <th class="csp-admin-quanlybacsi-quanlybacsi-ejs-6">Chuyên Khoa</th>
                                <th class="csp-admin-quanlybacsi-quanlybacsi-ejs-5">Chi Tiết</th>
                                <th class="text-center csp-admin-quanlybacsi-quanlybacsi-ejs-4">Thao Tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% let i = 1; %>
                            <% if(typeof danhSach !== 'undefined' && danhSach.length > 0) { %>
                                <% danhSach.forEach(bacsi => { %>
                                    <tr>
                                        <td class="text-center"><%= (currentPage - 1) * 10 + (i++) %></td>
                                        <td><strong class="text-dark"><%= bacsi.hoTen %></strong></td>
                                        <td class="text-center"><%= bacsi.namTotNghiep %></td>
                                        <td class="fw-semibold csp-admin-quanlybacsi-quanlybacsi-ejs-3">
                                            <%= bacsi.tenChuyenKhoa ? bacsi.tenChuyenKhoa : 'Chưa phân khoa' %>
                                        </td>
                                        
                                        <td title="<%= bacsi.chiTiet %>" class="text-muted text-truncate csp-admin-quanlybacsi-quanlybacsi-ejs-2">
                                            <%= bacsi.chiTiet %>
                                        </td>
                                        
                                        <td>
                                            <div class="action-wrapper">
                                                <a href="/admin/suaBacSi/<%= bacsi.id %>?page=<%= currentPage %>" class="btn-icon btn-edit" title="Sửa">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                
                                                <a href="/admin/xoaBacSi/<%= bacsi.id %>?page=<%= currentPage %>"
                                                class="btn-icon btn-delete text-danger js-confirm-link"
                                                data-confirm-message="Bạn có chắc chắn muốn xóa bác sĩ <%= bacsi.hoTen %>?"
                                                title="Xóa">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" class="text-center py-5 text-muted">
                                        <i class="fas fa-user-md mb-3 csp-admin-quanlybacsi-quanlybacsi-ejs-1"></i>
                                        <p class="mb-0 fs-5">Chưa có dữ liệu bác sĩ nào.</p>
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div> 
                <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
                    <nav aria-label="Page navigation" class="mt-4">
                        <ul class="pagination justify-content-center">
                            
                            <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                                <a class="page-link" href="?page=<%= currentPage - 1 %>">Trước</a>
                            </li>
                            
                            <% for(let p = 1; p <= totalPages; p++) { %>
                                <li class="page-item <%= p === currentPage ? 'active' : '' %>">
                                    <a class="page-link" href="?page=<%= p %>"><%= p %></a>
                                </li>
                            <% } %>
                            
                            <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                                <a class="page-link" href="?page=<%= currentPage + 1 %>">Sau</a>
                            </li>
                            
                        </ul>
                    </nav>
                <% } %>
            </div> 
        </div> 
    </div> 
<script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>