<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng Nhập Quản Trị</title>
    
    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css">
    
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/admin/login.css">

    <!-- Giao diện thông báo Bootstrap dùng chung -->
    <link rel="stylesheet" href="/css/migrated-inline.css?v=1">
    <link rel="stylesheet" href="/css/bootstrap-ui.css?v=2">
    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/js/bootstrap-ui.js?v=2"></script>
</head>
<body class="d-flex justify-content-center align-items-center vh-100 bg-gradient-primary">
    <% if (typeof uiMessage !== 'undefined' && uiMessage && uiMessage.message) { %>
      <template
        data-app-message="<%= uiMessage.message %>"
                data-app-type="<%= uiMessage.type || 'info' %>"
                data-app-title="<%= uiMessage.title || 'Thông báo' %>"></template>
    <% } %>


    <div class="card login-container border-0 shadow-lg">
        <div class="card-body p-4 p-md-5">
            <h2 class="text-center text-dark mb-4 fw-bold">Đăng Nhập Quản Lý</h2>

            <form action="/admin/login" method="POST">
                <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                <div class="mb-3">
                    <label for="username" class="form-label text-secondary fw-medium">Tài khoản</label>
                    <input type="text" class="form-control form-control-brand px-3 py-2" id="username" name="username" placeholder="Nhập tên đăng nhập..." required>
                </div>
                
                <div class="mb-4">
                    <label for="password" class="form-label text-secondary fw-medium">Mật khẩu</label>
                    <input type="password" class="form-control form-control-brand px-3 py-2" id="password" name="password" placeholder="Nhập mật khẩu..." required>
                </div>
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary btn-lg">
                        <i class="fa-solid fa-right-to-bracket"></i> Đăng nhập
                    </button>
                </div>
            </form>
        </div>
    </div>

    <% if (typeof message !== 'undefined' && message) { %>
        <template
            data-app-message="<%= message %>"
            data-app-type="error"
            data-app-title="Đăng nhập thất bại"
            data-app-mode="dialog"
            data-app-confirm-text="Thử lại"></template>
    <% } %>
</body>
</html>