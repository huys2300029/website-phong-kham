<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Đăng nhập</title>

    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css">

    <link rel="stylesheet" href="/css/admin/login.css">

    <link rel="stylesheet" href="/css/khachHang/login.css">

    <link rel="stylesheet" href="/css/khachHang/home.css">

    <!-- Giao diện thông báo Bootstrap dùng chung -->
    <link rel="stylesheet" href="/css/migrated-inline.css?v=1">
    <link rel="stylesheet" href="/css/bootstrap-ui.css?v=2">
    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/js/bootstrap-ui.js?v=2"></script>
</head>

<body class="bg-gradient-primary">
    <% if (typeof uiMessage !== 'undefined' && uiMessage && uiMessage.message) { %>
      <template
        data-app-message="<%= uiMessage.message %>"
                data-app-type="<%= uiMessage.type || 'info' %>"
                data-app-title="<%= uiMessage.title || 'Thông báo' %>"></template>
    <% } %>


    <%- include('../header') %>

        <div class="container d-flex justify-content-center align-items-center csp-khachhang-taikhoan-login-ejs-1">

            <div class="card login-container border-0 shadow-lg">

                <div class="card-body p-4 p-md-5">

                    <h2 class="text-center text-dark mb-4 fw-bold">
                        Đăng nhập
                    </h2>

                    <form action="/login" method="POST" autocomplete="off">

                        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

                        <div class="mb-3">

                            <label for="username" class="form-label text-secondary fw-medium">
                                Tên đăng nhập
                            </label>

                            <input type="text" id="username" name="username"
                                class="form-control form-control-brand px-3 py-2" placeholder="Nhập tên đăng nhập..."
                                autocomplete="username" required>

                        </div>

                        <div class="mb-4">

                            <label for="password" class="form-label text-secondary fw-medium">
                                Mật khẩu
                            </label>

                            <input type="password" id="password" name="password"
                                class="form-control form-control-brand px-3 py-2" placeholder="Nhập mật khẩu..."
                                autocomplete="current-password" required>

                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-3">

                            <a href="/khachHangTaoTaiKhoan" class="text-decoration-none">
                                Tạo tài khoản
                            </a>

                        </div>

                        <div class="d-grid">

                            <button type="submit" class="btn btn-primary btn-lg">

                                <i class="fa-solid fa-right-to-bracket"></i>

                                Đăng nhập

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

        <% if (typeof msg !== 'undefined' && msg) { %>
            <% const loginIsError = typeof type !== 'undefined' && type === 'error'; %>
            <template
                data-app-message="<%= msg %>"
                data-app-type="<%= loginIsError ? 'error' : 'success' %>"
                data-app-title="<%= loginIsError ? 'Đăng nhập thất bại' : 'Thành công' %>"
                data-app-mode="dialog"
                data-app-confirm-text="OK"></template>
        <% } %>

</body>

</html>