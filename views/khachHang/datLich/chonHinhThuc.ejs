<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Chọn hình thức đặt lịch</title>

    <link href="/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="/vendor/fontawesome/css/all.min.css">

    <link rel="stylesheet" href="/css/khachHang/home.css">

    <!-- Giao diện thông báo Bootstrap dùng chung -->
    <link rel="stylesheet" href="/css/migrated-inline.css?v=1">
    <link rel="stylesheet" href="/css/bootstrap-ui.css?v=2">
    <script src="/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/js/bootstrap-ui.js?v=2"></script>
</head>

<body class="bg-light">
    <% if (typeof uiMessage !== 'undefined' && uiMessage && uiMessage.message) { %>
      <template
        data-app-message="<%= uiMessage.message %>"
                data-app-type="<%= uiMessage.type || 'info' %>"
                data-app-title="<%= uiMessage.title || 'Thông báo' %>"></template>
    <% } %>


    <%- include("../header") %>

        <main class="container py-5">
            <div class="text-center mb-5">
                <h2 class="fw-bold text-primary">
                    Đăng ký khám bệnh
                </h2>

                <p class="text-muted fs-5 mb-0">
                    Vui lòng chọn hình thức khám phù hợp với nhu cầu của bạn
                </p>
            </div>

            <div class="row justify-content-center g-4">

                <!-- KHÁM THƯỜNG -->
                <div class="col-md-6 col-lg-5">
                    <a href="/datLichThuong" class="choice-link" aria-label="Chọn hình thức khám thường">
                        <div class="card choice-card text-center p-4">
                            <div class="card-body d-flex flex-column">

                                <div class="icon-box icon-box-success text-success">
                                    🩺
                                </div>

                                <h4 class="choice-title">
                                    Khám thường
                                </h4>

                                <p class="choice-desc">
                                    Phù hợp khi bạn muốn đặt lịch khám nhanh
                                    theo chuyên khoa. Hệ thống sẽ sắp xếp bác sĩ
                                    phù hợp theo ngày và khung giờ bạn chọn.
                                </p>

                                <span class="btn btn-outline-primary mt-2 rounded-pill px-4 py-2 fw-bold w-100">
                                    Chọn khám thường
                                </span>

                            </div>
                        </div>
                    </a>
                </div>

                <!-- KHÁM CHUYÊN GIA -->
                <div class="col-md-6 col-lg-5">
                    <a href="/datLichChuyenGia" class="choice-link" aria-label="Chọn hình thức khám chuyên gia">
                        <div class="card choice-card text-center p-4">
                            <div class="card-body d-flex flex-column">

                                <div class="icon-box icon-box-primary text-primary">
                                    👨‍⚕️
                                </div>

                                <h4 class="choice-title">
                                    Khám chuyên gia
                                </h4>

                                <p class="choice-desc">
                                    Phù hợp khi bạn muốn được khám với bác sĩ
                                    hoặc chuyên gia cụ thể, có thể xem thông tin
                                    bác sĩ trước khi đặt lịch.
                                </p>

                                <span class="btn btn-outline-primary mt-2 rounded-pill px-4 py-2 fw-bold w-100">
                                    Chọn khám chuyên gia
                                </span>

                            </div>
                        </div>
                    </a>
                </div>

            </div>
        </main>

        <%- include("../footer") %>
</body>

</html>